{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "local-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/local-app",
      "sourceRoot": "projects/local-app/src",
      "prefix": "app",
      "architect": {
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/local-app/**/*.ts", "projects/local-app/**/*.html"]
          }
        },
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/local-app",
            "index": "projects/local-app/src/index.html",
            "browser": "projects/local-app/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/local-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/local-app/src/favicon.png",
              "projects/local-app/src/assets",
              {
                "glob": "**/*",
                "input": "./projects/shared-lib/src/assets",
                "output": "/assets/"
              }
            ],
            "styles": [
              "projects/local-app/src/styles.scss",
              "projects/shared-lib/src/lib/styles/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false,
              "aot": true,
              "extractLicenses": true,
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kb",
                  "maximumError": "400kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/global-app/src/environments/environment.ts",
                  "with": "projects/global-app/src/environments/environment.prod.ts"
                },
                {
                  "replace": "projects/local-app/src/environments/environment.ts",
                  "with": "projects/local-app/src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "local-app:build:production"
            },
            "development": {
              "buildTarget": "local-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "local-app:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/local-app/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/local-app/src/favicon.png",
              "projects/local-app/src/assets",
              {
                "glob": "**/*",
                "input": "./projects/shared-lib/src/assets",
                "output": "/assets/"
              }
            ],
            "styles": [
              "projects/local-app/src/styles.scss",
              "projects/shared-lib/src/lib/styles/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "global-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/global-app",
      "sourceRoot": "projects/global-app/src",
      "prefix": "app",
      "architect": {
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/global-app/**/*.ts", "projects/global-app/**/*.html"]
          }
        },
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/global-app",
            "index": "projects/global-app/src/index.html",
            "browser": "projects/global-app/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/global-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/global-app/src/favicon.png",
              "projects/global-app/src/assets",
              {
                "glob": "**/*",
                "input": "./projects/shared-lib/src/assets",
                "output": "/assets/"
              }
            ],
            "styles": [
              "projects/global-app/src/styles.scss",
              "projects/shared-lib/src/lib/styles/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kb",
                  "maximumError": "400kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/global-app/src/environments/environment.ts",
                  "with": "projects/global-app/src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "global-app:build:production"
            },
            "development": {
              "buildTarget": "global-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "global-app:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/global-app/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/global-app/src/favicon.png",
              "projects/global-app/src/assets",
              {
                "glob": "**/*",
                "input": "./projects/shared-lib/src/assets",
                "output": "/assets/"
              }
            ],
            "styles": [
              "projects/global-app/src/styles.scss",
              "projects/shared-lib/src/lib/styles/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "shared-lib": {
      "projectType": "library",
      "root": "projects/shared-lib",
      "sourceRoot": "projects/shared-lib/src",
      "prefix": "lib",
      "architect": {
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/shared-lib/**/*.ts", "projects/shared-lib/**/*.html"]
          }
        },
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/shared-lib/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/shared-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/shared-lib/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  }
}
