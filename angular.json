        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/local-app",
            "index": "projects/local-app/src/index.html",
            "browser": "projects/local-app/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/local-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/local-app/src/favicon.png",
              "projects/local-app/src/assets",
              {
                "glob": "**/*",
                "input": "./projects/shared-lib/src/assets",
                "output": "/assets/"
              }
            ],
            "styles": [
              "projects/local-app/src/styles.scss",
              "projects/shared-lib/src/lib/styles/styles.scss",

              "node_modules/easymde/dist/easymde.min.css",
              "node_modules/prismjs/themes/prism-okaidia.css",
              "node_modules/prismjs/plugins/line-highlight/prism-line-highlight.css"
            ],
